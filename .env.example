# Copiez ce fichier en .env (ou définissez ces variables dans votre environnement)
# Ne jamais committer de vraies valeurs de secrets.
# main.py charge automatiquement ce fichier .env au démarrage (python-dotenv).

# Tunnel SSH (obligatoires, aucune valeur par défaut dans le code)
SSH_BASTION_HOST=bastion.preprod.acces-sap.net
SSH_BASTION_PORT=22
SSH_BASTION_USER=tunnel
SSH_REMOTE_TARGET=mysql-tcp-proxy.accessap-preprod-ops.svc.cluster.local:20184

# Connexion MySQL (via le tunnel)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=accessap_app
DB_PASSWORD=
DB_NAME=accessap_preprod

# Paramètres de traitement
SHARED_THRESHOLD=15
BATCH_SIZE=10000

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
